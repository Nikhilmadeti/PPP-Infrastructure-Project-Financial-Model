# Example secrets file for the dashboard's "Ask the model" AI assistant (app/chatbot.py).
#
# The real file, .streamlit/secrets.toml, is git-ignored because it holds your private API key.
# To set it up:
#   1. Copy this file to .streamlit/secrets.toml
#        PowerShell:  Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
#        macOS/Linux: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2. Get a free key at https://aistudio.google.com/apikey and paste it below.
#   3. Restart the dashboard:  streamlit run app/dashboard.py
#
# Never commit, email or zip up secrets.toml. Each person uses their own key.
# Without a key, the dashboard still works; only the assistant asks for a key in its panel.

# Required for the assistant: your Gemini API key.
GEMINI_API_KEY = "paste-your-key-here"

# Optional: the preferred Gemini model. If it is busy, out of quota or not found, the assistant
# falls back to gemini-flash-lite-latest, gemini-2.5-flash and gemini-2.5-flash-lite.
# Current model ids: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL = "gemini-flash-latest"
